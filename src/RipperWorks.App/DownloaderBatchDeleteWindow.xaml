<Window x:Class="RipperWorks.App.DownloaderBatchDeleteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Title}"
        Width="540"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Style="{StaticResource {x:Type Window}}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Text="{Binding Question}"
                   TextWrapping="Wrap"
                   Style="{StaticResource SectionTitleStyle}" />
        <Border Grid.Row="1"
                Margin="0,18,0,0"
                Style="{StaticResource CardStyle}">
            <StackPanel>
                <TextBlock Text="{Binding CountText}" />
                <TextBlock Margin="0,8,0,0"
                           Text="{Binding ActiveText}"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource WarningBrush}"
                           Visibility="{Binding ActiveVisibility}" />
                <TextBlock Margin="0,8,0,0"
                           Text="{Binding ArchiveNotice}"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource TextSecondaryBrush}" />
            </StackPanel>
        </Border>
        <WrapPanel Grid.Row="2"
                   Margin="0,18,0,0"
                   HorizontalAlignment="Right">
            <Button Margin="4"
                    Content="{Binding CancelLabel}"
                    IsCancel="True" />
            <Button Margin="4"
                    Content="{Binding DeleteLabel}"
                    Style="{StaticResource PrimaryButtonStyle}"
                    IsDefault="True"
                    Click="DeleteButton_OnClick" />
        </WrapPanel>
    </Grid>
</Window>
