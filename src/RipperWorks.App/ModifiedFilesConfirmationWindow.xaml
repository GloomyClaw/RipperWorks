<Window x:Class="RipperWorks.App.ModifiedFilesConfirmationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Title}"
        Width="580"
        MaxHeight="520"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Style="{StaticResource {x:Type Window}}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Text="{Binding Heading}"
                   TextWrapping="Wrap"
                   Style="{StaticResource SectionTitleStyle}" />
        <TextBlock Grid.Row="1"
                   Margin="0,12,0,12"
                   Text="{Binding Explanation}"
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource TextSecondaryBrush}" />
        <Border Grid.Row="2"
                Margin="0,0,0,16"
                MaxHeight="180"
                Style="{StaticResource CardStyle}">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding ModifiedPaths}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Margin="0,2"
                                       Text="{Binding}"
                                       FontFamily="Consolas, monospace"
                                       FontSize="11"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>
        <WrapPanel Grid.Row="3"
                   HorizontalAlignment="Right">
            <Button Margin="4"
                    MinWidth="100"
                    Content="{Binding CancelLabel}"
                    Click="CancelButton_OnClick" />
            <Button Margin="4"
                    MinWidth="140"
                    Content="{Binding ConfirmLabel}"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Click="ConfirmButton_OnClick" />
        </WrapPanel>
    </Grid>
</Window>
