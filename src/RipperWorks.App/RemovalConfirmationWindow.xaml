<Window x:Class="RipperWorks.App.RemovalConfirmationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Title}"
        Width="540"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Style="{StaticResource {x:Type Window}}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Text="{Binding Question}"
                   TextWrapping="Wrap"
                   Style="{StaticResource SectionTitleStyle}" />
        <Border Grid.Row="1"
                Margin="0,18,0,14"
                Style="{StaticResource CardStyle}">
            <StackPanel>
                <TextBlock Margin="0,3"
                           Text="{Binding DeleteSummary}" />
                <TextBlock Margin="0,3"
                           Text="{Binding RestoreSummary}" />
            </StackPanel>
        </Border>
        <TextBlock Grid.Row="2"
                   Text="{Binding ArchiveNotice}"
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource TextSecondaryBrush}" />
        <WrapPanel Grid.Row="3"
                   Margin="0,18,0,0"
                   HorizontalAlignment="Right">
            <Button Margin="4"
                    MinWidth="100"
                    Content="{Binding CancelLabel}"
                    Click="CancelButton_OnClick" />
            <Button Margin="4"
                    MinWidth="120"
                    Content="{Binding RemoveLabel}"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Click="RemoveButton_OnClick" />
        </WrapPanel>
    </Grid>
</Window>
