<Window x:Class="RipperWorks.App.GroupNameDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="460"
        MinWidth="380"
        Style="{StaticResource {x:Type Window}}"
        SizeToContent="Height"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Text="{Binding DialogTitle}"
                   Style="{StaticResource SectionTitleStyle}" />
        <TextBox x:Name="GroupNameBox"
                 Grid.Row="1"
                 Margin="0,18,0,20"
                 MinWidth="320"
                 Text="{Binding GroupName,
                                UpdateSourceTrigger=PropertyChanged}" />
        <StackPanel Grid.Row="2"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal">
            <Button x:Name="CancelGroupButton"
                    MinWidth="100"
                    Content="{Binding CancelLabel}"
                    IsCancel="True" />
            <Button x:Name="AcceptGroupButton"
                    MinWidth="110"
                    Margin="10,0,0,0"
                    Content="{Binding ActionLabel}"
                    IsDefault="True"
                    Click="AcceptButton_OnClick"
                    Style="{StaticResource PrimaryButtonStyle}" />
        </StackPanel>
    </Grid>
</Window>
