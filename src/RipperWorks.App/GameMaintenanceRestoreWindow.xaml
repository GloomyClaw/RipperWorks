<Window x:Class="RipperWorks.App.GameMaintenanceRestoreWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Title}"
        Width="680"
        Height="500"
        MinWidth="540"
        MinHeight="380"
        WindowStartupLocation="CenterOwner"
        Style="{StaticResource {x:Type Window}}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Text="{Binding Heading}"
                   TextWrapping="Wrap"
                   Style="{StaticResource SectionTitleStyle}" />
        <TextBlock Grid.Row="1"
                   Margin="0,8,0,12"
                   Text="{Binding Subtitle}"
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource TextSecondaryBrush}" />
        <DataGrid Grid.Row="2"
                  Margin="0,0,0,16"
                  ItemsSource="{Binding Backups}"
                  SelectedItem="{Binding SelectedBackup}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  CanUserReorderColumns="False"
                  CanUserResizeRows="False"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  SelectionUnit="FullRow">
            <DataGrid.Columns>
                <DataGridTextColumn Header="{Binding DataContext.DateHeader,
                                                    RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}"
                                    Width="180"
                                    Binding="{Binding FormattedDate}" />
                <DataGridTextColumn Header="{Binding DataContext.FilesHeader,
                                                    RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}"
                                    Width="90"
                                    Binding="{Binding FileCount}" />
                <DataGridTextColumn Header="{Binding DataContext.SizeHeader,
                                                    RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}"
                                    Width="120"
                                    Binding="{Binding FormattedSize}" />
                <DataGridTextColumn Header="{Binding DataContext.IdHeader,
                                                    RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}"
                                    Width="*"
                                    Binding="{Binding BackupId}" />
            </DataGrid.Columns>
        </DataGrid>
        <WrapPanel Grid.Row="3"
                   HorizontalAlignment="Right">
            <Button Margin="4"
                    MinWidth="100"
                    Content="{Binding CancelLabel}"
                    Click="CancelButton_OnClick" />
            <Button Margin="4"
                    MinWidth="140"
                    Content="{Binding RestoreLabel}"
                    IsEnabled="{Binding CanRestore}"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Click="RestoreButton_OnClick" />
        </WrapPanel>
    </Grid>
</Window>
