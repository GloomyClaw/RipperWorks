<UserControl x:Class="RipperWorks.App.Views.DownloadsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:RipperWorks.App"
             xmlns:core="clr-namespace:RipperWorks.Core;assembly=RipperWorks.Core">
    <UserControl.Resources>
        <local:DownloaderStatusConverter x:Key="DownloaderStatusConverter" />
        <local:DownloaderSourceConverter x:Key="DownloaderSourceConverter" />
        <local:ByteSizeConverter x:Key="ByteSizeConverter" />
        <local:NexusUpdateStatusConverter
            x:Key="NexusUpdateStatusConverter" />
        <local:NexusUpdateTooltipConverter
            x:Key="NexusUpdateTooltipConverter" />
        <Style TargetType="GroupBox">
            <Setter Property="Foreground"
                    Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="BorderBrush"
                    Value="{DynamicResource BorderBrush}" />
            <Setter Property="Background"
                    Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GroupBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="7"
                                Padding="14">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <ContentPresenter ContentSource="Header"
                                                  Margin="2,0,2,10"
                                                  TextElement.FontWeight="SemiBold" />
                                <ContentPresenter Grid.Row="1" />
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ProgressBar">
            <Setter Property="Background"
                    Value="{DynamicResource ControlBackgroundBrush}" />
            <Setter Property="Foreground"
                    Value="{DynamicResource AccentBrush}" />
            <Setter Property="BorderBrush"
                    Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3">
                            <Grid ClipToBounds="True">
                                <Rectangle x:Name="PART_Track"
                                           Fill="{TemplateBinding Background}" />
                                <Rectangle x:Name="PART_Indicator"
                                           Fill="{TemplateBinding Foreground}"
                                           HorizontalAlignment="Left" />
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Grid Margin="24,18,24,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Top Control Region: Exactly Two Side-by-Side Companion Panels -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" MinWidth="340" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="3*" MinWidth="480" />
            </Grid.ColumnDefinitions>

            <!-- LEFT PANEL: Add Mods -->
            <GroupBox x:Name="AddModsGroup"
                      Grid.Column="0"
                      Header="{Binding AddSectionLabel}">
                <Grid Margin="4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- ROW 1: 3-column equal Grid for Import, Manual, Export -->
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0"
                                Margin="2"
                                Content="{Binding ImportLabel}"
                                Command="{Binding ImportCommand}" />
                        <Button Grid.Column="1"
                                Margin="2"
                                Content="{Binding AddManualLabel}"
                                Command="{Binding AddManualCommand}" />
                        <Button Grid.Column="2"
                                Margin="2"
                                Content="{Binding ExportLabel}"
                                Command="{Binding ExportCommand}" />
                    </Grid>

                    <!-- ROW 2: Link input (star) and Add Link button (auto) -->
                    <Grid Grid.Row="1" Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0"
                                 Margin="2"
                                 Text="{Binding LinkText,
                                                UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="{Binding LinkPlaceholder}" />
                        <Button Grid.Column="1"
                                Margin="4,2,2,2"
                                MinWidth="100"
                                Content="{Binding AddLinkLabel}"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Command="{Binding AddLinkCommand}" />
                    </Grid>
                </Grid>
            </GroupBox>

            <!-- RIGHT PANEL: Search / Management -->
            <GroupBox x:Name="ManagementGroup"
                      Grid.Column="2"
                      Header="{Binding ManagementSectionLabel}">
                <Grid Margin="4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- ROW 0: Search TextBox -->
                    <TextBox Grid.Row="0"
                             x:Name="DownloadsSearchBox"
                             Margin="2,0,2,6"
                             Text="{Binding SearchText,
                                            UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="{Binding SearchPlaceholder}" />

                    <!-- ROW 1: Three Functional Columns (Filters, Selection, Maintenance) -->
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.2*" MinWidth="130" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="*" MinWidth="110" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="*" MinWidth="120" />
                        </Grid.ColumnDefinitions>

                        <!-- COLUMN A: Filters (Vertical Stack) -->
                        <StackPanel Grid.Column="0">
                            <ComboBox Margin="2"
                                      ItemsSource="{Binding StatusChoices}"
                                      DisplayMemberPath="Display"
                                      SelectedValuePath="Value"
                                      SelectedValue="{Binding StatusFilter}" />
                            <ComboBox Margin="2"
                                      ItemsSource="{Binding CategoryChoices}"
                                      DisplayMemberPath="Display"
                                      SelectedValuePath="Value"
                                      SelectedValue="{Binding CategoryFilter}" />
                            <ComboBox Margin="2"
                                      ItemsSource="{Binding SourceChoices}"
                                      DisplayMemberPath="Display"
                                      SelectedValuePath="Value"
                                      SelectedValue="{Binding SourceFilter}" />
                        </StackPanel>

                        <!-- COLUMN B: Selection (Vertical Stack) -->
                        <StackPanel Grid.Column="2">
                            <Button Margin="2"
                                    Content="{Binding SelectVisibleLabel}"
                                    Command="{Binding SelectVisibleCommand}" />
                            <Button Margin="2"
                                    Content="{Binding ClearSelectionLabel}"
                                    Command="{Binding ClearSelectionCommand}" />
                            <Button Margin="2"
                                    Content="{Binding SelectAllLabel}"
                                    Command="{Binding SelectAllCommand}" />
                        </StackPanel>

                        <!-- COLUMN C: Maintenance (Vertical Stack) -->
                        <StackPanel Grid.Column="4">
                            <Button Margin="2"
                                    Content="{Binding RefreshStatusesLabel}"
                                    Command="{Binding RefreshStatusesCommand}" />
                            <Button Margin="2"
                                    Content="{Binding CheckUpdatesLabel}"
                                    Command="{Binding CheckUpdatesCommand}" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </GroupBox>
        </Grid>

        <DataGrid x:Name="DownloadsGrid"
                  Grid.Row="1"
                  ItemsSource="{Binding EntriesView}"
                  SelectedItem="{Binding SelectedEntry}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserResizeColumns="True"
                  CanUserSortColumns="True"
                  SelectionMode="Single"
                  SelectionUnit="FullRow"
                  MouseDoubleClick="DownloadsGrid_OnMouseDoubleClick"
                  PreviewMouseRightButtonDown="DownloadsGrid_OnPreviewMouseRightButtonDown"
                  HorizontalScrollBarVisibility="Auto"
                  VerticalScrollBarVisibility="Auto">
            <DataGrid.ContextMenu>
                <ContextMenu DataContext="{Binding PlacementTarget.DataContext,
                                                  RelativeSource={RelativeSource Self}}">
                    <MenuItem Header="{Binding OpenPageLabel}"
                              Command="{Binding OpenPageCommand}" />
                    <MenuItem Header="{Binding CheckUpdateLabel}"
                              Command="{Binding CheckSelectedUpdateCommand}"
                              IsEnabled="{Binding CanCheckSelectedUpdate}" />
                    <MenuItem Header="{Binding OpenUpdateLabel}"
                              Command="{Binding OpenSelectedUpdateCommand}"
                              Visibility="{Binding CanOpenSelectedUpdate,
                                                   Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <MenuItem Header="{Binding StartLabel}"
                              Command="{Binding StartSelectedCommand}"
                              Visibility="{Binding CanStartSelectedEntry,
                                                   Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <MenuItem Header="{Binding PauseLabel}"
                              Command="{Binding PauseSelectedCommand}"
                              Visibility="{Binding CanPauseSelectedEntry,
                                                   Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <MenuItem Header="{Binding ResumeLabel}"
                              Command="{Binding ResumeSelectedCommand}"
                              Visibility="{Binding CanResumeSelectedEntry,
                                                   Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <MenuItem Header="{Binding CancelLabel}"
                              Command="{Binding CancelSelectedCommand}"
                              Visibility="{Binding CanCancelSelectedEntry,
                                                   Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <MenuItem Header="{Binding RetryLabel}"
                              Command="{Binding RetrySelectedCommand}"
                              Visibility="{Binding CanRetrySelectedEntry,
                                                   Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <Separator />
                    <MenuItem Header="{Binding EditLabel}"
                              Command="{Binding EditCommand}" />
                    <MenuItem Header="{Binding AttachLabel}"
                              Command="{Binding AttachArchiveCommand}" />
                    <MenuItem Header="{Binding OpenFileLabel}"
                              Command="{Binding OpenFileCommand}"
                              Visibility="{Binding CanOpenDownloadedEntry,
                                                   Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <MenuItem Header="{Binding OpenFolderLabel}"
                              Command="{Binding OpenFolderCommand}"
                              Visibility="{Binding CanOpenDownloadedEntry,
                                                   Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <MenuItem Header="{Binding CopyLinkLabel}"
                              Command="{Binding CopyLinkCommand}" />
                    <MenuItem Header="{Binding CopySha256Label}"
                              Command="{Binding CopySha256Command}" />
                    <Separator />
                    <MenuItem Header="{Binding DeleteLabel}"
                              Command="{Binding DeleteSelectedCommand}" />
                </ContextMenu>
            </DataGrid.ContextMenu>
            <DataGrid.Columns>
                <DataGridTemplateColumn Width="36" MinWidth="32">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding IsSelected,
                                                         Mode=TwoWay,
                                                         UpdateSourceTrigger=PropertyChanged}"
                                      HorizontalAlignment="Center" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="№"
                                    Binding="{Binding Number}"
                                    Width="50"
                                    MinWidth="45" />
                <DataGridTemplateColumn Width="*" MinWidth="220">
                    <DataGridTemplateColumn.Header>
                        <TextBlock Text="{Binding DataContext.NameColumn,
                                                 RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}" />
                    </DataGridTemplateColumn.Header>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Name}"
                                       ToolTip="{Binding Name}"
                                       TextTrimming="CharacterEllipsis" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Width="170" MinWidth="150">
                    <DataGridTemplateColumn.Header>
                        <TextBlock Text="{Binding DataContext.CategoryColumn,
                                                 RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}" />
                    </DataGridTemplateColumn.Header>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Category}"
                                       ToolTip="{Binding Category}"
                                       TextTrimming="CharacterEllipsis" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Binding="{Binding Source,
                                                      Converter={StaticResource DownloaderSourceConverter}}"
                                    Width="90"
                                    MinWidth="80">
                    <DataGridTextColumn.Header>
                        <TextBlock Text="{Binding DataContext.SourceColumn,
                                                 RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}" />
                    </DataGridTextColumn.Header>
                </DataGridTextColumn>
                <DataGridTemplateColumn Width="150" MinWidth="130">
                    <DataGridTemplateColumn.Header>
                        <TextBlock Text="{Binding DataContext.AuthorColumn,
                                                 RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}" />
                    </DataGridTemplateColumn.Header>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Author}"
                                       ToolTip="{Binding Author}"
                                       TextTrimming="CharacterEllipsis" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="mod_id"
                                    Binding="{Binding NexusModId}"
                                    Width="78"
                                    MinWidth="70" />
                <DataGridTextColumn Header="file_id"
                                    Binding="{Binding NexusFileId}"
                                    Width="82"
                                    MinWidth="75" />
                <DataGridTextColumn Binding="{Binding Version}"
                                    Width="100"
                                    MinWidth="90">
                    <DataGridTextColumn.Header>
                        <TextBlock Text="{Binding DataContext.VersionColumn,
                                                 RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}" />
                    </DataGridTextColumn.Header>
                </DataGridTextColumn>
                <DataGridTemplateColumn Width="170" MinWidth="150">
                    <DataGridTemplateColumn.Header>
                        <TextBlock Text="{Binding DataContext.UpdateColumn,
                                                 RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}" />
                    </DataGridTemplateColumn.Header>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock TextTrimming="CharacterEllipsis">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground"
                                                Value="{DynamicResource TextSecondaryBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding UpdateCheckStatus}"
                                                         Value="{x:Static core:NexusUpdateCheckStatus.UpdateAvailable}">
                                                <Setter Property="Foreground"
                                                        Value="{DynamicResource WarningBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding UpdateCheckStatus}"
                                                         Value="{x:Static core:NexusUpdateCheckStatus.UpToDate}">
                                                <Setter Property="Foreground"
                                                        Value="{DynamicResource SuccessBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding UpdateCheckStatus}"
                                                         Value="{x:Static core:NexusUpdateCheckStatus.ManualReviewRequired}">
                                                <Setter Property="Foreground"
                                                        Value="{DynamicResource WarningBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding UpdateCheckStatus}"
                                                         Value="{x:Static core:NexusUpdateCheckStatus.Checking}">
                                                <Setter Property="Foreground"
                                                        Value="{DynamicResource TextPrimaryBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding UpdateCheckStatus}"
                                                         Value="{x:Static core:NexusUpdateCheckStatus.ApiError}">
                                                <Setter Property="Foreground"
                                                        Value="{DynamicResource ErrorBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                                <TextBlock.Text>
                                    <MultiBinding Converter="{StaticResource NexusUpdateStatusConverter}">
                                        <Binding Path="UpdateCheckStatus" />
                                        <Binding Path="AvailableVersion" />
                                        <Binding Path="DataContext.Localization"
                                                 RelativeSource="{RelativeSource AncestorType={x:Type DataGrid}}" />
                                    </MultiBinding>
                                </TextBlock.Text>
                                <TextBlock.ToolTip>
                                    <MultiBinding Converter="{StaticResource NexusUpdateTooltipConverter}">
                                        <Binding Path="Version" />
                                        <Binding Path="AvailableVersion" />
                                        <Binding Path="LastUpdateCheckUtc" />
                                        <Binding Path="UpdateCheckMessage" />
                                        <Binding Path="DataContext.Localization"
                                                 RelativeSource="{RelativeSource AncestorType={x:Type DataGrid}}" />
                                    </MultiBinding>
                                </TextBlock.ToolTip>
                            </TextBlock>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Width="160" MinWidth="140">
                    <DataGridTemplateColumn.Header>
                        <TextBlock Text="{Binding DataContext.StatusColumn,
                                                 RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}" />
                    </DataGridTemplateColumn.Header>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Status,
                                                     Converter={StaticResource DownloaderStatusConverter}}"
                                       ToolTip="{Binding Status,
                                                         Converter={StaticResource DownloaderStatusConverter}}"
                                       TextTrimming="CharacterEllipsis" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Width="132" MinWidth="120">
                    <DataGridTemplateColumn.Header>
                        <TextBlock Text="{Binding DataContext.ProgressColumn,
                                                 RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}" />
                    </DataGridTemplateColumn.Header>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Grid>
                                <ProgressBar Height="18"
                                             Maximum="100"
                                             Value="{Binding Progress}" />
                                <TextBlock Text="{Binding Progress,
                                                         StringFormat={}{0:0}%}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextPrimaryBrush}" />
                            </Grid>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Binding="{Binding Size,
                                                      Converter={StaticResource ByteSizeConverter}}"
                                    Width="95"
                                    MinWidth="85">
                    <DataGridTextColumn.Header>
                        <TextBlock Text="{Binding DataContext.SizeColumn,
                                                 RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}" />
                    </DataGridTextColumn.Header>
                </DataGridTextColumn>
                <DataGridTemplateColumn Width="160" MinWidth="145">
                    <DataGridTemplateColumn.Header>
                        <TextBlock Text="{Binding DataContext.Sha256Column,
                                                 RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}" />
                    </DataGridTemplateColumn.Header>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Sha256Display}"
                                       ToolTip="{Binding Sha256}"
                                       TextTrimming="CharacterEllipsis" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <Grid Grid.Row="2" Margin="0,10,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                       Margin="2,0,2,6"
                       Text="{Binding StatusMessage}"
                       ToolTip="{Binding StatusMessage}"
                       TextTrimming="CharacterEllipsis"
                       MaxHeight="36"
                       Style="{StaticResource SecondaryTextStyle}" />

            <WrapPanel Grid.Row="1">
                <Button Margin="2"
                        Content="{Binding UpdateSelectedLabel}"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Command="{Binding UpdateSelectedCommand}" />
                <Button Margin="2"
                        Content="{Binding StartLabel}"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Command="{Binding StartSelectedCommand}" />
                <Button Margin="2"
                        Content="{Binding PauseLabel}"
                        Command="{Binding PauseSelectedCommand}" />
                <Button Margin="2"
                        Content="{Binding ResumeLabel}"
                        Command="{Binding ResumeSelectedCommand}" />
                <Button Margin="2"
                        Content="{Binding CancelLabel}"
                        Command="{Binding CancelSelectedCommand}" />
                <Button Margin="2"
                        Content="{Binding RetryLabel}"
                        Command="{Binding RetrySelectedCommand}" />
                <Button Margin="2"
                        Content="{Binding DeleteLabel}"
                        Command="{Binding DeleteSelectedCommand}" />
            </WrapPanel>
        </Grid>

        <Border Grid.Row="1"
                Margin="40"
                Padding="24"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource ErrorBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Visibility="{Binding HasInitializationError,
                                     Converter={StaticResource BooleanToVisibilityConverter}}">
            <TextBlock MaxWidth="620"
                       Text="{Binding InitializationError}"
                       TextAlignment="Center"
                       TextWrapping="Wrap" />
        </Border>
    </Grid>
</UserControl>
