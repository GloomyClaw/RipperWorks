<UserControl x:Class="RipperWorks.App.Views.NexusBrowserView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
             xmlns:views="clr-namespace:RipperWorks.App.Views"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="1000"
             Background="{DynamicResource WindowBackgroundBrush}">
    <UserControl.Resources>
        <views:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter" />
        <views:NullToVisibilityConverter x:Key="NullToVisibilityConverter" />
    </UserControl.Resources>

    <Grid Background="{DynamicResource WindowBackgroundBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="340" MinWidth="280" MaxWidth="440" />
        </Grid.ColumnDefinitions>

        <!-- Left: Contained WebView2 Browser -->
        <Grid Grid.Column="0">
            <wv2:WebView2 x:Name="Browser"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch" />
        </Grid>

        <!-- Center: Divider -->
        <Border Grid.Column="1"
                Width="1"
                Background="{DynamicResource DividerBrush}"
                HorizontalAlignment="Center"
                VerticalAlignment="Stretch" />

        <!-- Right: RipperWorks Side Panel -->
        <Border Grid.Column="2"
                Background="{DynamicResource SurfaceBrush}"
                Padding="14,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Segmented Two-Way Tab Selector (Mod / Shortlist) -->
                <Border Grid.Row="0"
                        Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="2">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="4" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Mod Tab Button -->
                        <Button Grid.Column="0"
                                Content="{Binding Panel.CurrentModTabHeader}"
                                Command="{Binding Panel.SelectCurrentModTabCommand}"
                                Padding="8,5"
                                FontSize="12"
                                HorizontalAlignment="Stretch"
                                Cursor="Hand">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="{DynamicResource TransparentBrush}" />
                                    <Setter Property="BorderBrush" Value="{DynamicResource TransparentBrush}" />
                                    <Setter Property="BorderThickness" Value="1" />
                                    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                    <Setter Property="FontWeight" Value="Normal" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="TabBorder"
                                                        Background="{TemplateBinding Background}"
                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="{TemplateBinding BorderThickness}"
                                                        CornerRadius="3"
                                                        Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="Center"
                                                                      VerticalAlignment="Center" />
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Panel.IsCurrentModTabSelected}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource SelectionBrush}" />
                                            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                            <Setter Property="FontWeight" Value="SemiBold" />
                                        </DataTrigger>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding Panel.IsCurrentModTabSelected}" Value="False" />
                                                <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=IsMouseOver}" Value="True" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
                                            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <!-- Shortlist Tab Button -->
                        <Button Grid.Column="2"
                                Content="{Binding Panel.ShortlistTabHeader}"
                                Command="{Binding Panel.SelectShortlistTabCommand}"
                                Padding="8,5"
                                FontSize="12"
                                HorizontalAlignment="Stretch"
                                Cursor="Hand">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="{DynamicResource TransparentBrush}" />
                                    <Setter Property="BorderBrush" Value="{DynamicResource TransparentBrush}" />
                                    <Setter Property="BorderThickness" Value="1" />
                                    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                    <Setter Property="FontWeight" Value="Normal" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="TabBorder"
                                                        Background="{TemplateBinding Background}"
                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="{TemplateBinding BorderThickness}"
                                                        CornerRadius="3"
                                                        Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="Center"
                                                                      VerticalAlignment="Center" />
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Panel.IsShortlistTabSelected}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource SelectionBrush}" />
                                            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                            <Setter Property="FontWeight" Value="SemiBold" />
                                        </DataTrigger>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding Panel.IsShortlistTabSelected}" Value="False" />
                                                <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=IsMouseOver}" Value="True" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
                                            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </Grid>
                </Border>

                <!-- Shortlist Operation Error Banner -->
                <Border Grid.Row="1"
                        Visibility="{Binding Panel.ShortlistOperationErrorText, Converter={StaticResource NullToVisibilityConverter}}"
                        Padding="8,6"
                        Margin="0,8,0,0"
                        BorderThickness="1"
                        BorderBrush="{DynamicResource ErrorBrush}"
                        Background="{DynamicResource SurfaceBrush}"
                        CornerRadius="3">
                    <TextBlock Text="{Binding Panel.ShortlistOperationErrorText}"
                               Foreground="{DynamicResource ErrorBrush}"
                               FontSize="12"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap"
                               TextAlignment="Center" />
                </Border>

                <!-- Tab 1: Current Mod View -->
                <ScrollViewer Grid.Row="3"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Visibility="{Binding Panel.IsCurrentModTabSelected, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel>
                        <!-- Neutral state when no mod page is loaded -->
                        <Border Visibility="{Binding Panel.HasActiveModContext, Converter={StaticResource InverseBooleanToVisibilityConverter}}"
                                Padding="16,40"
                                HorizontalAlignment="Center">
                            <TextBlock Text="{Binding Panel.NoModMessage}"
                                       TextWrapping="Wrap"
                                       TextAlignment="Center"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       FontSize="13" />
                        </Border>

                        <!-- Active Current Mod Inspector -->
                        <StackPanel Visibility="{Binding Panel.HasActiveModContext, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Text="{Binding Panel.CurrentModTitle}"
                                       FontSize="16"
                                       FontWeight="Bold"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextPrimaryBrush}" />

                            <TextBlock Text="{Binding Panel.CurrentModSubtitle}"
                                       FontSize="12"
                                       Margin="0,2,0,4"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />

                            <!-- Metadata details (Author, Version, Category) -->
                            <StackPanel Margin="0,0,0,10"
                                        Visibility="{Binding Panel.HasAnyMetadata, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock Text="{Binding Panel.CurrentModAuthor}"
                                           FontSize="12"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           Margin="0,1"
                                           Visibility="{Binding Panel.CurrentModAuthor, Converter={StaticResource NullToVisibilityConverter}}" />
                                <TextBlock Text="{Binding Panel.CurrentModVersion}"
                                           FontSize="12"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           Margin="0,1"
                                           Visibility="{Binding Panel.CurrentModVersion, Converter={StaticResource NullToVisibilityConverter}}" />
                                <TextBlock Text="{Binding Panel.CurrentModCategory}"
                                           FontSize="12"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           Margin="0,1"
                                           Visibility="{Binding Panel.CurrentModCategory, Converter={StaticResource NullToVisibilityConverter}}" />
                            </StackPanel>

                            <!-- Metadata loading indicator -->
                            <TextBlock Text="{DynamicResource NexusBrowserPanelLoadingMetadata}"
                                       FontSize="11"
                                       FontStyle="Italic"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Margin="0,0,0,8"
                                       Visibility="{Binding Panel.IsMetadataLoading, Converter={StaticResource BooleanToVisibilityConverter}}" />

                            <!-- Metadata error banner -->
                            <Border Visibility="{Binding Panel.HasMetadataError, Converter={StaticResource BooleanToVisibilityConverter}}"
                                    Padding="6,4"
                                    Margin="0,0,0,8"
                                    BorderThickness="1"
                                    BorderBrush="{DynamicResource ErrorBrush}"
                                    Background="{DynamicResource SurfaceBrush}"
                                    CornerRadius="3">
                                <TextBlock Text="{Binding Panel.MetadataErrorText}"
                                           Foreground="{DynamicResource ErrorBrush}"
                                           FontSize="11"
                                           TextWrapping="Wrap" />
                            </Border>

                            <!-- Add / Remove Shortlist Action Button -->
                            <Button Content="{Binding Panel.ShortlistButtonText}"
                                    Command="{Binding Panel.ToggleShortlistCommand}"
                                    Padding="12,8"
                                    Margin="0,0,0,14"
                                    FontWeight="SemiBold"
                                    FontSize="13"
                                    HorizontalAlignment="Stretch" />

                            <!-- Read-Only Local State Card -->
                            <Border Style="{StaticResource CardStyle}"
                                    Padding="12"
                                    Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="{Binding Panel.LocalStatusHeader}"
                                               FontWeight="SemiBold"
                                               FontSize="12"
                                               Margin="0,0,0,6"
                                               Foreground="{DynamicResource TextPrimaryBrush}" />

                                    <TextBlock Text="{Binding Panel.LocalStatusText}"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Margin="0,0,0,4"
                                               Foreground="{DynamicResource AccentBrush}"
                                               Visibility="{Binding Panel.LocalStatusText, Converter={StaticResource NullToVisibilityConverter}}" />

                                    <TextBlock Text="{Binding Panel.LocalVersionsText}"
                                               FontSize="11"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               TextWrapping="Wrap"
                                               Visibility="{Binding Panel.LocalVersionsText, Converter={StaticResource NullToVisibilityConverter}}" />

                                    <!-- Downloader Action for Current Mod -->
                                    <Button Content="{Binding Panel.CurrentModDownloaderActionText}"
                                            Command="{Binding Panel.AddCurrentModToDownloadsCommand}"
                                            Visibility="{Binding Panel.CanAddToCurrentModDownloads, Converter={StaticResource BooleanToVisibilityConverter}}"
                                            Margin="0,8,0,0"
                                            Padding="10,5"
                                            FontSize="11"
                                            FontWeight="SemiBold"
                                            HorizontalAlignment="Stretch" />

                                    <Button Content="{Binding Panel.CurrentModDownloaderActionText}"
                                            Command="{Binding Panel.OpenCurrentModInDownloadsCommand}"
                                            Visibility="{Binding Panel.CanOpenCurrentModInDownloads, Converter={StaticResource BooleanToVisibilityConverter}}"
                                            Margin="0,8,0,0"
                                            Padding="10,5"
                                            FontSize="11"
                                            FontWeight="SemiBold"
                                            HorizontalAlignment="Stretch" />
                                </StackPanel>
                            </Border>

                            <!-- Read-Only Requirements & Dependencies Card -->
                            <Border Style="{StaticResource CardStyle}"
                                    Padding="12"
                                    Margin="0,0,0,12">
                                <StackPanel>
                                    <!-- Requirements Header & Refresh Button -->
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding Panel.ForwardRequirementsHeader}"
                                                   FontWeight="SemiBold"
                                                   FontSize="12"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextPrimaryBrush}" />

                                        <Button Grid.Column="1"
                                                Content="↻"
                                                ToolTip="{DynamicResource NexusBrowserPanelRefreshRequirements}"
                                                Command="{Binding Panel.RefreshRequirementsCommand}"
                                                Padding="6,2"
                                                FontSize="12"
                                                FontWeight="Bold" />
                                    </Grid>

                                    <!-- Requirements loading indicator -->
                                    <TextBlock Text="{DynamicResource NexusBrowserPanelLoadingRequirements}"
                                               FontSize="11"
                                               FontStyle="Italic"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               Margin="0,0,0,6"
                                               Visibility="{Binding Panel.IsRequirementsLoading, Converter={StaticResource BooleanToVisibilityConverter}}" />

                                    <!-- Requirements error banner -->
                                    <Border Visibility="{Binding Panel.HasRequirementsError, Converter={StaticResource BooleanToVisibilityConverter}}"
                                            Padding="6,4"
                                            Margin="0,0,0,6"
                                            BorderThickness="1"
                                            BorderBrush="{DynamicResource ErrorBrush}"
                                            Background="{DynamicResource SurfaceBrush}"
                                            CornerRadius="3">
                                        <TextBlock Text="{Binding Panel.RequirementsErrorText}"
                                                   Foreground="{DynamicResource ErrorBrush}"
                                                   FontSize="11"
                                                   TextWrapping="Wrap" />
                                    </Border>

                                    <!-- Ambiguous Source Notification Banner (Visible when ambiguous, regardless of cached rows) -->
                                    <Border Visibility="{Binding Panel.IsRequirementsAmbiguous, Converter={StaticResource BooleanToVisibilityConverter}}"
                                            Padding="6,4"
                                            Margin="0,0,0,6"
                                            BorderThickness="1"
                                            BorderBrush="{DynamicResource BorderBrush}"
                                            Background="{DynamicResource CardBrush}"
                                            CornerRadius="3">
                                        <TextBlock Text="{Binding Panel.AmbiguousRequirementsMessage}"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   FontSize="11"
                                                   FontStyle="Italic"
                                                   TextWrapping="Wrap" />
                                    </Border>

                                    <!-- Forward Requirements List -->
                                    <ItemsControl ItemsSource="{Binding Panel.ForwardRequirements}"
                                                  Visibility="{Binding Panel.HasForwardRequirements, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{DynamicResource BackgroundBrush}"
                                                        BorderBrush="{DynamicResource BorderBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="3"
                                                        Padding="8,6"
                                                        Margin="0,0,0,6">
                                                    <Grid>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="Auto" />
                                                        </Grid.RowDefinitions>

                                                        <Grid Grid.Row="0">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>

                                                            <TextBlock Grid.Column="0"
                                                                       Text="{Binding DisplayName}"
                                                                       FontWeight="SemiBold"
                                                                       FontSize="12"
                                                                       TextWrapping="Wrap"
                                                                       Foreground="{DynamicResource TextPrimaryBrush}" />

                                                            <StackPanel Grid.Column="1"
                                                                        Orientation="Horizontal"
                                                                        VerticalAlignment="Top">
                                                                <Border Background="{DynamicResource CardBrush}"
                                                                        BorderBrush="{DynamicResource BorderBrush}"
                                                                        BorderThickness="1"
                                                                        CornerRadius="2"
                                                                        Padding="4,1"
                                                                        Margin="4,0,0,0"
                                                                        Visibility="{Binding HasAdultIndicator, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                                    <TextBlock Text="{Binding AdultIndicatorText}"
                                                                               FontSize="10"
                                                                               FontWeight="Bold"
                                                                               Foreground="{DynamicResource AccentBrush}" />
                                                                </Border>
                                                                <Border Background="{DynamicResource CardBrush}"
                                                                        BorderBrush="{DynamicResource BorderBrush}"
                                                                        BorderThickness="1"
                                                                        CornerRadius="2"
                                                                        Padding="4,1"
                                                                        Margin="4,0,0,0">
                                                                    <TextBlock Text="{Binding LocalStatusText}"
                                                                               FontSize="10"
                                                                               FontWeight="SemiBold"
                                                                               Foreground="{DynamicResource AccentBrush}" />
                                                                </Border>
                                                            </StackPanel>
                                                        </Grid>

                                                        <TextBlock Grid.Row="1"
                                                                   Text="{Binding Notes}"
                                                                   FontSize="10"
                                                                   FontStyle="Italic"
                                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                                   TextWrapping="Wrap"
                                                                   Margin="0,2,0,0"
                                                                   Visibility="{Binding HasNotes, Converter={StaticResource BooleanToVisibilityConverter}}" />

                                                        <StackPanel Grid.Row="2"
                                                                    Orientation="Horizontal"
                                                                    Margin="0,4,0,0">
                                                            <Button Content="{Binding OpenOnNexusText}"
                                                                    Command="{Binding OpenInNexusCommand}"
                                                                    Margin="0,0,6,0"
                                                                    Padding="6,3"
                                                                    FontSize="11"
                                                                    Visibility="{Binding CanOpenInNexus, Converter={StaticResource BooleanToVisibilityConverter}}" />

                                                            <Button Content="{Binding DownloaderActionText}"
                                                                    Command="{Binding AddToDownloadsCommand}"
                                                                    Visibility="{Binding CanAddToDownloads, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                                    Padding="6,3"
                                                                    FontSize="11" />

                                                            <Button Content="{Binding DownloaderActionText}"
                                                                    Command="{Binding OpenInDownloadsCommand}"
                                                                    Visibility="{Binding CanOpenInDownloads, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                                    Padding="6,3"
                                                                    FontSize="11" />
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <!-- No Requirements Message -->
                                    <TextBlock Text="{Binding Panel.NoRequirementsMessage}"
                                               FontSize="11"
                                               FontStyle="Italic"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               Margin="0,2,0,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding Panel.HasAnyRequirements}" Value="False" />
                                                            <Condition Binding="{Binding Panel.IsRequirementsLoading}" Value="False" />
                                                            <Condition Binding="{Binding Panel.HasRequirementsError}" Value="False" />
                                                            <Condition Binding="{Binding Panel.IsRequirementsAmbiguous}" Value="False" />
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </MultiDataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <!-- Tab 2: Shortlist (N) View -->
                <Grid Grid.Row="3"
                      Visibility="{Binding Panel.IsShortlistTabSelected, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <!-- Empty State -->
                    <Border Visibility="{Binding Panel.IsShortlistEmpty, Converter={StaticResource BooleanToVisibilityConverter}}"
                            Padding="16,40"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                        <TextBlock Text="{Binding Panel.EmptyShortlistMessage}"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   FontSize="13" />
                    </Border>

                    <!-- Non-Empty Shortlist Items List -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Visibility="{Binding Panel.IsShortlistEmpty, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                        <ItemsControl ItemsSource="{Binding Panel.ShortlistItems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource CardStyle}"
                                            Padding="10"
                                            Margin="0,0,0,8">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="8" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <!-- Mod Display Name -->
                                            <TextBlock Grid.Row="0"
                                                       Text="{Binding DisplayName}"
                                                       FontWeight="Bold"
                                                       FontSize="13"
                                                       TextWrapping="Wrap"
                                                       Foreground="{DynamicResource TextPrimaryBrush}" />

                                            <!-- Subtitle / Mod ID -->
                                            <TextBlock Grid.Row="1"
                                                       Text="{Binding Subtitle}"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       Margin="0,2,0,2" />

                                            <!-- Author and Version (rendered only when present) -->
                                            <WrapPanel Grid.Row="2"
                                                       Margin="0,0,0,4">
                                                <TextBlock Text="{Binding Author}"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                                           Visibility="{Binding Author, Converter={StaticResource NullToVisibilityConverter}}"
                                                           Margin="0,0,8,0" />
                                                <TextBlock Text="{Binding LastKnownVersion}"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                                           Visibility="{Binding LastKnownVersion, Converter={StaticResource NullToVisibilityConverter}}" />
                                            </WrapPanel>

                                            <!-- Local State Badge -->
                                            <TextBlock Grid.Row="3"
                                                       Text="{Binding LocalStatusText}"
                                                       FontSize="11"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource AccentBrush}"
                                                       Visibility="{Binding LocalStatusText, Converter={StaticResource NullToVisibilityConverter}}" />

                                            <!-- Row Actions -->
                                            <Grid Grid.Row="5">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="6" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <Button Grid.Column="0"
                                                        Content="{Binding OpenOnNexusText}"
                                                        Command="{Binding OpenInNexusCommand}"
                                                        Padding="6,4"
                                                        FontSize="11"
                                                        HorizontalAlignment="Stretch" />

                                                <Button Grid.Column="2"
                                                        Content="{Binding RemoveText}"
                                                        Command="{Binding RemoveCommand}"
                                                        Padding="8,4"
                                                        FontSize="11" />
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
