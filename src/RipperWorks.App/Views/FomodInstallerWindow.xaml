<Window x:Class="RipperWorks.App.Views.FomodInstallerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:RipperWorks.App.ViewModels"
        mc:Ignorable="d"
        Title="{Binding WindowTitle}"
        Width="700" Height="550"
        WindowStartupLocation="CenterOwner"
        Background="#18181B" Foreground="#F4F4F5">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Margin="0,0,0,12" Padding="12" Background="#27272A" CornerRadius="6">
            <StackPanel>
                <TextBlock Text="{Binding ModuleName}" FontSize="18" FontWeight="Bold" Foreground="#FAFAFA"/>
                <TextBlock Text="{Binding StepLabel}" FontSize="14" Foreground="#A1A1AA" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <!-- Main Options List -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,12">
            <ItemsControl ItemsSource="{Binding CurrentStep.Groups}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:FomodGroupViewModel}">
                        <Border Margin="0,0,0,16" Padding="12" Background="#27272A" CornerRadius="6" BorderBrush="#3F3F46" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold" Foreground="#60A5FA"/>
                                <TextBlock Text="{Binding GroupTypeDisplay}" FontSize="12" Foreground="#A1A1AA" Margin="0,2,0,8"/>

                                <ItemsControl ItemsSource="{Binding Options}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:FomodPluginOptionViewModel}">
                                            <Border Margin="0,4" Padding="8" Background="#18181B" CornerRadius="4">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}" VerticalAlignment="Top" Margin="0,2,8,0"/>
                                                    <StackPanel Grid.Column="1">
                                                        <TextBlock Text="{Binding Name}" FontWeight="Bold" Foreground="#F4F4F5"/>
                                                        <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Foreground="#D4D4D8" FontSize="12" Margin="0,2,0,0">
                                                            <TextBlock.Style>
                                                                <Style TargetType="{x:Type TextBlock}" BasedOn="{StaticResource {x:Type TextBlock}}">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Description}" Value="{x:Null}">
                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding Description}" Value="">
                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Validation Error Message -->
        <TextBlock Grid.Row="2" Text="{Binding ValidationError}" Foreground="#EF4444" FontWeight="Medium" Margin="0,0,0,12" TextWrapping="Wrap">
            <TextBlock.Style>
                <Style TargetType="{x:Type TextBlock}" BasedOn="{StaticResource {x:Type TextBlock}}">
                    <Setter Property="Visibility" Value="Visible"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ValidationError}" Value="{x:Null}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding ValidationError}" Value="">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <!-- Footer Action Buttons -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="BackButton" Content="{Binding BackButtonText}" Command="{Binding PreviousStepCommand}" Width="90" Height="32" Margin="0,0,8,0" Background="#3F3F46" Foreground="#FAFAFA">
                <Button.Style>
                    <Style TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
                        <Setter Property="Visibility" Value="Visible"/>
                        <Style.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
            <Button Content="{Binding NextButtonText}" Command="{Binding NextStepCommand}" Width="90" Height="32" Margin="0,0,8,0" Background="#3F3F46" Foreground="#FAFAFA">
                <Button.Style>
                    <Style TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
                        <Setter Property="Visibility" Value="Visible"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsLastStep}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
            <Button Content="{Binding InstallButtonText}" Command="{Binding ContinueCommand}" Width="110" Height="32" Background="#2563EB" Foreground="#FAFAFA" FontWeight="Bold" Visibility="{Binding IsLastStep, Converter={StaticResource BooleanToVisibilityConverter}}"/>
        </StackPanel>
    </Grid>
</Window>
