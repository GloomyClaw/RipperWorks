<Window x:Class="RipperWorks.App.NexusFileSelectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Title}"
        Width="820"
        Height="520"
        MinWidth="650"
        MinHeight="400"
        WindowStartupLocation="CenterOwner"
        Style="{StaticResource {x:Type Window}}">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="{Binding ModName}"
                       Style="{StaticResource PageTitleStyle}" />
            <TextBlock Margin="0,5,0,12"
                       Text="{Binding Hint}"
                       Style="{StaticResource SecondaryTextStyle}" />
        </StackPanel>
        <DataGrid Grid.Row="1"
                  ItemsSource="{Binding Files}"
                  SelectedItem="{Binding SelectedFile}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  SelectionUnit="FullRow"
                  SelectionMode="Single">
            <DataGrid.Columns>
                <DataGridTextColumn Header="file_id"
                                    Binding="{Binding FileId}"
                                    Width="80" />
                <DataGridTextColumn Binding="{Binding Name}" Width="2*">
                    <DataGridTextColumn.Header>
                        <TextBlock Text="{Binding DataContext.NameHeader,
                                                 RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}" />
                    </DataGridTextColumn.Header>
                </DataGridTextColumn>
                <DataGridTextColumn Binding="{Binding FileName}" Width="2*">
                    <DataGridTextColumn.Header>
                        <TextBlock Text="{Binding DataContext.FileHeader,
                                                 RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}" />
                    </DataGridTextColumn.Header>
                </DataGridTextColumn>
                <DataGridTextColumn Binding="{Binding Version}" Width="100">
                    <DataGridTextColumn.Header>
                        <TextBlock Text="{Binding DataContext.VersionHeader,
                                                 RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}" />
                    </DataGridTextColumn.Header>
                </DataGridTextColumn>
                <DataGridTextColumn Binding="{Binding Size}" Width="110">
                    <DataGridTextColumn.Header>
                        <TextBlock Text="{Binding DataContext.SizeHeader,
                                                 RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}" />
                    </DataGridTextColumn.Header>
                </DataGridTextColumn>
                <DataGridTextColumn Binding="{Binding UpdatedAt}" Width="150">
                    <DataGridTextColumn.Header>
                        <TextBlock Text="{Binding DataContext.DateHeader,
                                                 RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}" />
                    </DataGridTextColumn.Header>
                </DataGridTextColumn>
            </DataGrid.Columns>
        </DataGrid>
        <WrapPanel Grid.Row="2"
                   Margin="0,16,0,0"
                   HorizontalAlignment="Right">
            <Button Margin="4"
                    MinWidth="100"
                    Content="{Binding CancelLabel}"
                    IsCancel="True" />
            <Button Margin="4"
                    MinWidth="120"
                    Content="{Binding SelectLabel}"
                    IsDefault="True"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Click="SelectButton_OnClick" />
        </WrapPanel>
    </Grid>
</Window>
