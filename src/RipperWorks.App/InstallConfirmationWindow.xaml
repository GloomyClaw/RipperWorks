<Window x:Class="RipperWorks.App.InstallConfirmationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Title}"
        Width="520"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Style="{StaticResource {x:Type Window}}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Text="{Binding Question}"
                   TextWrapping="Wrap"
                   Style="{StaticResource SectionTitleStyle}" />
        <Border Grid.Row="1"
                Margin="0,18,0,16"
                Style="{StaticResource CardStyle}">
            <StackPanel>
                <TextBlock Margin="0,3"
                           Text="{Binding AddSummary}" />
                <TextBlock Margin="0,3"
                           Text="{Binding ReplaceSummary}" />
                <TextBlock Margin="0,3"
                           Text="{Binding OverlaySummary}" />
                <TextBlock Margin="0,3"
                           Text="{Binding ConflictSummary}" />
            </StackPanel>
        </Border>
        <WrapPanel Grid.Row="2"
                   HorizontalAlignment="Right">
            <Button Margin="4"
                    MinWidth="100"
                    Content="{Binding CancelLabel}"
                    Click="CancelButton_OnClick" />
            <Button Margin="4"
                    MinWidth="100"
                    Content="{Binding InstallLabel}"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Click="InstallButton_OnClick" />
        </WrapPanel>
    </Grid>
</Window>
