<Window x:Class="RipperWorks.App.DownloaderImportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Title}"
        Width="1050"
        Height="700"
        MinWidth="760"
        MinHeight="500"
        WindowStartupLocation="CenterOwner"
        Style="{StaticResource {x:Type Window}}">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2.2*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="105" />
                <ColumnDefinition Width="125" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <DockPanel Margin="0,0,8,5">
                    <TextBlock Text="{Binding SheetLabel}" />
                    <CheckBox HorizontalAlignment="Right"
                              Content="{Binding MultipleSheetsLabel}"
                              IsChecked="{Binding MultiSheetMode}" />
                </DockPanel>
                <ComboBox ItemsSource="{Binding Sheets}"
                          DisplayMemberPath="Display"
                          SelectedItem="{Binding SelectedSheet}"
                          SelectionChanged="Sheet_OnSelectionChanged" />
                <Border Margin="0,6,8,0"
                        MaxHeight="110"
                        Padding="5"
                        Background="{DynamicResource ControlBackgroundBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="5"
                        Visibility="{Binding MultiSheetMode,
                                             Converter={StaticResource BooleanToVisibilityConverter}}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Sheets}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox Margin="3"
                                              Content="{Binding Display}"
                                              IsChecked="{Binding IsSelected,
                                                                  Mode=TwoWay}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>
            </StackPanel>
            <StackPanel Grid.Column="1"
                        Margin="8,0"
                        Visibility="{Binding IsDelimited,
                                             Converter={StaticResource BooleanToVisibilityConverter}}">
                <TextBlock Margin="0,0,0,5"
                           Text="{Binding EncodingLabel}" />
                <ComboBox ItemsSource="{Binding Encodings}"
                          DisplayMemberPath="Display"
                          SelectedValuePath="Value"
                          SelectedValue="{Binding SelectedEncoding}" />
            </StackPanel>
            <StackPanel Grid.Column="2"
                        Margin="8,0"
                        Visibility="{Binding IsDelimited,
                                             Converter={StaticResource BooleanToVisibilityConverter}}">
                <TextBlock Margin="0,0,0,5"
                           Text="{Binding DelimiterLabel}" />
                <ComboBox ItemsSource="{Binding Delimiters}"
                          DisplayMemberPath="Display"
                          SelectedValuePath="Value"
                          SelectedValue="{Binding SelectedDelimiter}" />
            </StackPanel>
            <StackPanel Grid.Column="3" Margin="8,0">
                <TextBlock Margin="0,0,0,5"
                           Text="{Binding HeaderRowLabel}" />
                <TextBox Text="{Binding HeaderRowText,
                                        UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>
            <StackPanel Grid.Column="4" Margin="8,0,0,0">
                <TextBlock Margin="0,0,0,5"
                           Text="{Binding DataStartLabel}" />
                <TextBox Text="{Binding DataStartText,
                                        UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>
        </Grid>
        <DockPanel Grid.Row="1" Margin="0,12,0,8">
            <Button DockPanel.Dock="Right"
                    Content="{Binding RefreshLabel}"
                    Click="RefreshButton_OnClick" />
            <TextBlock Text="{Binding DetectionSummary}"
                       Style="{StaticResource SecondaryTextStyle}" />
        </DockPanel>
        <DataGrid Grid.Row="2"
                  ItemsSource="{Binding PreviewRows}"
                  AutoGenerateColumns="True"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  CanUserSortColumns="False"
                  HorizontalScrollBarVisibility="Auto"
                  VerticalScrollBarVisibility="Auto" />
        <Grid Grid.Row="3" Margin="0,14,0,0">
            <TextBlock Text="{Binding PreviewHint}"
                       Style="{StaticResource SecondaryTextStyle}" />
            <WrapPanel HorizontalAlignment="Right">
                <Button Margin="4"
                        MinWidth="100"
                        Content="{Binding CancelLabel}"
                        IsCancel="True" />
                <Button Margin="4"
                        MinWidth="120"
                        Content="{Binding ContinueLabel}"
                        Style="{StaticResource PrimaryButtonStyle}"
                        IsDefault="True"
                        Click="ContinueButton_OnClick" />
            </WrapPanel>
        </Grid>
    </Grid>
</Window>
