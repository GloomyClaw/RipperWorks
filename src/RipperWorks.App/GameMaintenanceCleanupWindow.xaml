<Window x:Class="RipperWorks.App.GameMaintenanceCleanupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Title}"
        Width="640"
        Height="540"
        MinWidth="500"
        MinHeight="400"
        WindowStartupLocation="CenterOwner"
        Style="{StaticResource {x:Type Window}}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Text="{Binding Heading}"
                   TextWrapping="Wrap"
                   Style="{StaticResource SectionTitleStyle}" />
        <TextBlock Grid.Row="1"
                   Margin="0,8,0,12"
                   Text="{Binding Subtitle}"
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource TextSecondaryBrush}" />
        <Border Grid.Row="2"
                Margin="0,0,0,16"
                Style="{StaticResource CardStyle}">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding CandidatePaths}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Margin="0,2"
                                       Text="{Binding}"
                                       FontFamily="Consolas, monospace"
                                       FontSize="11"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>
        <CheckBox Grid.Row="3"
                  Margin="0,0,0,16"
                  IsChecked="{Binding CreateBackup}"
                  Content="{Binding CreateBackupLabel}" />
        <WrapPanel Grid.Row="4"
                   HorizontalAlignment="Right">
            <Button Margin="4"
                    MinWidth="100"
                    Content="{Binding CancelLabel}"
                    Click="CancelButton_OnClick" />
            <Button Margin="4"
                    MinWidth="140"
                    Content="{Binding CleanLabel}"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Click="CleanButton_OnClick" />
        </WrapPanel>
    </Grid>
</Window>
