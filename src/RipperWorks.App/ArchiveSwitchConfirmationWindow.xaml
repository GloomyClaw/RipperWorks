<Window x:Class="RipperWorks.App.ArchiveSwitchConfirmationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Title}"
        Width="560"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Style="{StaticResource {x:Type Window}}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="{Binding Heading}"
                       Style="{StaticResource SectionTitleStyle}" />
            <TextBlock Margin="0,10,0,0"
                       Text="{Binding InstalledVersion}" />
            <TextBlock Margin="0,4,0,0"
                       Text="{Binding TargetVersion}" />
        </StackPanel>
        <Border Grid.Row="1"
                Margin="0,18,0,14"
                Style="{StaticResource CardStyle}">
            <StackPanel>
                <TextBlock Margin="0,3" Text="{Binding AddSummary}" />
                <TextBlock Margin="0,3" Text="{Binding ReplaceSummary}" />
                <TextBlock Margin="0,3" Text="{Binding ObsoleteSummary}" />
                <TextBlock Margin="0,3" Text="{Binding RestoreSummary}" />
                <TextBlock Margin="0,3" Text="{Binding ConflictSummary}" />
            </StackPanel>
        </Border>
        <CheckBox x:Name="DeleteOldArchiveCheckBox"
                  Grid.Row="2"
                  Margin="0,0,0,18"
                  Content="{Binding DeleteOldArchiveLabel}"
                  IsChecked="False" />
        <WrapPanel Grid.Row="3"
                   HorizontalAlignment="Right">
            <Button Margin="4"
                    MinWidth="100"
                    Content="{Binding CancelLabel}"
                    Click="CancelButton_OnClick" />
            <Button Margin="4"
                    MinWidth="100"
                    Content="{Binding ConfirmLabel}"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Click="ConfirmButton_OnClick" />
        </WrapPanel>
    </Grid>
</Window>
