<Window x:Class="RipperWorks.App.ManualDownloadWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Title}"
        Width="620"
        Height="590"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Style="{StaticResource {x:Type Window}}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="145" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Margin="0,12" Text="{Binding NameLabel}" />
            <TextBox Grid.Column="1"
                     Margin="0,3"
                     Text="{Binding Name,
                                    UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock Grid.Row="1" Margin="0,12"
                       Text="{Binding CategoryLabel}" />
            <TextBox Grid.Row="1" Grid.Column="1" Margin="0,3"
                     Text="{Binding Category}" />
            <TextBlock Grid.Row="2" Margin="0,12"
                       Text="{Binding SourceLabel}" />
            <ComboBox Grid.Row="2" Grid.Column="1" Margin="0,3"
                      ItemsSource="{Binding Sources}"
                      DisplayMemberPath="Display"
                      SelectedValuePath="Value"
                      SelectedValue="{Binding Source}" />
            <TextBlock Grid.Row="3" Margin="0,12"
                       Text="{Binding AuthorLabel}" />
            <TextBox Grid.Row="3" Grid.Column="1" Margin="0,3"
                     Text="{Binding Author}" />
            <TextBlock Grid.Row="4" Margin="0,12"
                       Text="URL" />
            <TextBox Grid.Row="4" Grid.Column="1" Margin="0,3"
                     Text="{Binding Url}" />
            <TextBlock Grid.Row="5" Margin="0,12"
                       Text="{Binding VersionLabel}" />
            <TextBox Grid.Row="5" Grid.Column="1" Margin="0,3"
                     Text="{Binding Version}" />
            <TextBlock Grid.Row="6" Margin="0,12"
                       Text="{Binding ArchiveLabel}" />
            <Grid Grid.Row="6" Grid.Column="1" Margin="0,3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox Text="{Binding ArchivePath}" IsReadOnly="True" />
                <Button Grid.Column="1" Margin="8,0,0,0"
                        Content="{Binding BrowseLabel}"
                        Click="BrowseButton_OnClick" />
            </Grid>
        </Grid>
        <WrapPanel Grid.Row="1"
                   HorizontalAlignment="Right">
            <Button Margin="4" MinWidth="100"
                    Content="{Binding CancelLabel}"
                    IsCancel="True" />
            <Button Margin="4" MinWidth="110"
                    Content="{Binding SaveLabel}"
                    IsDefault="True"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Click="SaveButton_OnClick" />
        </WrapPanel>
    </Grid>
</Window>
